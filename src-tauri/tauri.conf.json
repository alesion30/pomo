{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pomo",
  "version": "0.1.0",
  "identifier": "dev.alesion30.pomo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "popover",
        "label": "popover",
        "width": 320,
        "height": 420,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "title": "front",
        "label": "front",
        "width": 420,
        "height": 380,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": { "signingIdentity": "-" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxODczQjJCMEMwMjNCNEQKUldSTk93SU1LenVIOFVHRVR5V1Z2dVBEaXQrLzMzN1lQaUlXSHNEYk1ndS9DUlJ2V0l5STR6THIK",
      "endpoints": [
        "https://github.com/alesion30/pomo/releases/latest/download/latest.json"
      ]
    }
  }
}
